# Copy to .env (scripts/bootstrap.sh does this once). Never commit .env.
# Placeholders only. Fill secrets on the machine; do not paste them into chat.
# Simple values need no quotes. Quote a value that contains spaces.

# --- App ---
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string
MOCK_DB=false

# --- Supabase (server-side) ---
# Project URL from the Supabase dashboard (https://YOUR_PROJECT.supabase.co).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Service role key. The process writes every table. Do not put this key in a mobile app.
SUPABASE_KEY=your_supabase_service_role_key

# --- Auth ---
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
TOKEN_EXPIRATION_MINUTES=60

# Fernet key used to encrypt the stored Garmin password.
# Generate on the box (do not invent a password string):
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-fernet-key

# --- Athlete ---
# IANA zone for wake status when users.goals.timezone is empty.
# Example only: set the athlete's real zone. Also set the box timezone to this zone
# so the 07:00-11:00 cron matches their morning.
GYMBRO_ATHLETE_TIMEZONE=
# Filled by scripts/create_athlete.sh. The wake cron reads GYMBRO_USER_ID.
GYMBRO_USER_ID=
# Optional. Limits scheduler/CLI sync when more than one user has Garmin.
GYMBRO_GARMIN_SYNC_USER_IDS=

# Garmin login. Read only by scripts/create_athlete.sh, then stored encrypted
# on the user row. The sync CLI does not read these. Remove them from .env
# after connect if you do not want the password to stay on disk.
GARMIN_EMAIL=athlete@example.com
GARMIN_PASSWORD=your-garmin-password
# Gymbro login created by scripts/create_athlete.sh (not read by the Flask app).
ATHLETE_USERNAME=athlete@example.com
ATHLETE_PASSWORD=replace-with-a-password

# --- MCP (stdio: python -m app.mcp) ---
# Personal API key. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
GYMBRO_MCP_API_KEY=replace-with-a-long-random-string
# Athlete id bound to that key. Same value as GYMBRO_USER_ID.
GYMBRO_MCP_USER_ID=
# Optional JWT from /auth/login. Leave empty when using the API key.
GYMBRO_MCP_TOKEN=
GYMBRO_MCP_DNS_REBINDING_PROTECTION=false
GYMBRO_MCP_ALLOWED_HOSTS=
GYMBRO_MCP_ALLOWED_ORIGINS=
GYMBRO_MCP_STATELESS=false
GYMBRO_MCP_HTTP_DISABLE=false

# --- Wake webhook (scripts/wake_poll_cron.sh) ---
# Routine URL and sender key from the bot. POST {"event":"wake_up",...}
# with Authorization: Bearer $WAKE_WEBHOOK_KEY. Leave empty to poll without a POST.
WAKE_WEBHOOK_URL=
WAKE_WEBHOOK_KEY=

# --- Garmin sync scheduler (Flask process; the wake cron is separate) ---
ENABLE_TELEMETRY_SCHEDULER=false
TELEMETRY_SYNC_INTERVAL_HOURS=6
SCHEDULER_LOCK_FILE=
INTERNAL_JOB_TOKEN=

# --- Strava (optional) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
REDIRECT_URI=http://127.0.0.1:5001/strava/exchange_token

# --- LLM (optional; the Grok Bot coaches through MCP and does not need these) ---
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
LOCAL_LLM_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=gemma-2-9b-it
OPENAI_MODEL=gpt-4o
XAI_MODEL=grok-4-1-fast-non-reasoning
XAI_REASONING_MODEL=grok-4-1-fast-reasoning
EMBEDDING_PROVIDER=gemini
# Set false unless this machine has Google Cloud credentials.
USE_VERTEX_AI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET_NAME=your-gcs-bucket

# --- HTTP ---
CORS_ORIGIN=http://localhost:3000
CORS_ORIGINS=
